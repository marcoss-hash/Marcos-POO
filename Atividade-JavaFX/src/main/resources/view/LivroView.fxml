<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.LivroController"
            prefWidth="1050.0" prefHeight="680.0"
            style="-fx-background-color: #f4f6f9;">

    <top>
        <VBox spacing="5.0" style="-fx-background-color: #17324d;">
            <padding>
                <Insets top="22.0" right="28.0" bottom="22.0" left="28.0" />
            </padding>
            <Label text="Biblioteca Cultural"
                   style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label text="Sistema de cadastro e gerenciamento de livros"
                   style="-fx-font-size: 13px; -fx-text-fill: #dbe7f2;" />
        </VBox>
    </top>

    <center>
        <VBox spacing="14.0">
            <padding>
                <Insets top="22.0" right="28.0" bottom="18.0" left="28.0" />
            </padding>

            <Label text="Dados do livro"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #17324d;" />

            <GridPane hgap="14.0" vgap="7.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="40.0" hgrow="ALWAYS" />
                    <ColumnConstraints percentWidth="30.0" hgrow="ALWAYS" />
                    <ColumnConstraints percentWidth="15.0" hgrow="ALWAYS" />
                    <ColumnConstraints percentWidth="15.0" hgrow="ALWAYS" />
                </columnConstraints>

                <Label text="Título" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label text="Autor" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Ano" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <Label text="Páginas" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <TextField fx:id="txtTitulo" promptText="Título do livro"
                           GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtAutor" promptText="Nome do autor"
                           GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <TextField fx:id="txtAno" promptText="Ex.: 2020"
                           GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <TextField fx:id="txtPaginas" promptText="Ex.: 250"
                           GridPane.columnIndex="3" GridPane.rowIndex="1" />
            </GridPane>

            <HBox spacing="10.0">
                <Button text="Salvar livro" onAction="#salvarLivro"
                        style="-fx-background-color: #1f6f50; -fx-text-fill: white; -fx-font-weight: bold;" />
                <Button text="Novo / Limpar" onAction="#novoLivro" />
                <Button text="Editar selecionado" onAction="#editarSelecionado" />
                <Button text="Excluir selecionado" onAction="#excluirSelecionado"
                        style="-fx-background-color: #a93636; -fx-text-fill: white;" />
            </HBox>

            <Label text="Acervo cadastrado"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #17324d;" />

            <HBox spacing="10.0">
                <TextField fx:id="txtBusca" promptText="Buscar pelo título do livro" HBox.hgrow="ALWAYS" />
                <Button text="Buscar" onAction="#buscarPorTitulo" />
                <Button text="Mostrar todos" onAction="#mostrarTodos" />
            </HBox>

            <TableView fx:id="tabelaLivros" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="Nenhum livro cadastrado. Preencha o formulário para adicionar o primeiro." />
                </placeholder>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="65.0" />
                    <TableColumn fx:id="colTitulo" text="Título" prefWidth="330.0" />
                    <TableColumn fx:id="colAutor" text="Autor" prefWidth="260.0" />
                    <TableColumn fx:id="colAno" text="Ano" prefWidth="110.0" />
                    <TableColumn fx:id="colPaginas" text="Páginas" prefWidth="110.0" />
                </columns>
            </TableView>

            <Label fx:id="lblStatus" text="Pronto para cadastrar um novo livro."
                   style="-fx-text-fill: #526579; -fx-font-size: 12px;" />
        </VBox>
    </center>
</BorderPane>
